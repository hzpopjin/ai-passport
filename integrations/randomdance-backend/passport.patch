+import {
+  Body, CanActivate, Controller, Delete, ExecutionContext, Get, Header, Injectable,
+  Param, Patch, Post, Put, Req, StreamableFile, UseGuards,
+} from '@nestjs/common';
+import { AuthGuard } from '@nestjs/passport';
+import { createReadStream } from 'fs';
+import { Request } from 'express';
+import { CurrentUser } from '../../common/decorators/current-user.decorator';
+import { SkipResponseWrap } from '../../common/decorators/skip-response-wrap.decorator';
+import { PassportDevice } from './passport.entity';
+import { PassportService } from './passport.service';
+
+type DeviceRequest = Request & { passportDevice: PassportDevice };
+
+@Injectable()
+export class PassportDeviceGuard implements CanActivate {
+  constructor(private readonly service: PassportService) {}
+  async canActivate(context: ExecutionContext) {
+    const request = context.switchToHttp().getRequest<DeviceRequest>();
+    request.passportDevice = await this.service.authenticate(request.headers.authorization);
+    return true;
+  }
+}
+
+@Controller('passport')
+export class PassportPublicController {
+  constructor(private readonly service: PassportService) {}
+
+  @Post('device/register')
+  register(@Body() body: { device_id?: string; device_secret?: string }) {
+    return this.service.register(body?.device_id || '', body?.device_secret || '');
+  }
+
+  @Get('cards/:slug')
+  card(@Param('slug') slug: string) { return this.service.card(slug); }
+}
+
+@Controller('passport/device')
+@UseGuards(PassportDeviceGuard)
+export class PassportDeviceController {
+  constructor(private readonly service: PassportService) {}
+
+  @Post('pairings')
+  beginPairing(@Req() req: DeviceRequest) { return this.service.beginPairing(req.passportDevice); }
+
+  @Get('pairings/:id')
+  pairingStatus(@Req() req: DeviceRequest, @Param('id') id: string) {
+    return this.service.pairingStatus(req.passportDevice, id);
+  }
+
+  @Post('pairings/:id/confirm')
+  confirm(@Req() req: DeviceRequest, @Param('id') id: string) {
+    return this.service.confirm(req.passportDevice, id);
+  }
+
+  @Get('desired-theme')
+  desired(@Req() req: DeviceRequest) { return this.service.desiredTheme(req.passportDevice); }
+
+  @Get('themes/:id/pack')
+  @SkipResponseWrap()
+  @Header('Content-Type', 'application/octet-stream')
+  @Header('Cache-Control', 'no-store')
+  async pack(@Req() req: DeviceRequest, @Param('id') id: string) {
+    const { path, size } = await this.service.themeFile(req.passportDevice, id);
+    return new StreamableFile(createReadStream(path), { length: size, type: 'application/octet-stream' });
+  }
+
+  @Post('applied')
+  applied(@Req() req: DeviceRequest, @Body() body: { id?: string; sha256?: string }) {
+    return this.service.applied(req.passportDevice, body?.id || '', body?.sha256 || '');
+  }
+}
+
+@Controller('passport')
+@UseGuards(AuthGuard('jwt'))
+export class PassportUserController {
+  constructor(private readonly service: PassportService) {}
+
+  @Post('pairings/:code/claim')
+  claim(@Param('code') code: string, @CurrentUser('id') userId: number) {
+    return this.service.claim(code, userId);
+  }
+
+  @Get('devices')
+  devices(@CurrentUser('id') userId: number) { return this.service.mine(userId); }
+
+  @Delete('devices/:id')
+  unbind(@CurrentUser('id') userId: number, @Param('id') id: string) {
+    return this.service.unbind(userId, id);
+  }
+
+  @Put('devices/:id/theme')
+  theme(@CurrentUser('id') userId: number, @Param('id') id: string, @Body() body: { theme_id?: string }) {
+    return this.service.setTheme(userId, id, body?.theme_id || '');
+  }
+
+  @Patch('devices/:id/card')
+  cardVisibility(@CurrentUser('id') userId: number, @Param('id') id: string, @Body() body: { public?: boolean }) {
+    return this.service.setCardPublic(userId, id, body?.public as boolean);
+  }
+
+  @Get('cards/:slug/mine')
+  ownCard(@Param('slug') slug: string, @CurrentUser('id') userId: number) {
+    return this.service.card(slug, userId);
+  }
+
+  @Get('themes')
+  themes() { return [{ id: 'classic', title: '经典主题', version: 1, builtin: true }, ...this.service.themes()]; }
+}
