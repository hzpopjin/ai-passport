+import { Module } from '@nestjs/common';
+import { TypeOrmModule } from '@nestjs/typeorm';
+import { AuthModule } from '../auth/auth.module';
+import { User } from '../users/entities/user.entity';
+import { PassportDevice, PassportPairing } from './passport.entity';
+import {
+  PassportDeviceController, PassportDeviceGuard,
+  PassportPublicController, PassportUserController,
+} from './passport.controller';
+import { PassportService } from './passport.service';
+
+@Module({
+  imports: [TypeOrmModule.forFeature([PassportDevice, PassportPairing, User]), AuthModule],
+  controllers: [PassportPublicController, PassportDeviceController, PassportUserController],
+  providers: [PassportService, PassportDeviceGuard],
+})
+export class PassportModule {}
