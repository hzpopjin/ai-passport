+import { Column, CreateDateColumn, Entity, Index, PrimaryColumn, UpdateDateColumn } from 'typeorm';
+
+@Entity('passport_devices')
+export class PassportDevice {
+  @PrimaryColumn({ type: 'char', length: 32 }) id: string;
+  @Column({ type: 'char', length: 64 }) credential_hash: string;
+  @Index() @Column({ type: 'int', nullable: true }) owner_id: number | null;
+  @Index({ unique: true }) @Column({ type: 'char', length: 32 }) card_slug: string;
+  @Column({ type: 'boolean', default: false }) card_public: boolean;
+  @Column({ type: 'varchar', length: 64, default: 'classic' }) desired_theme: string;
+  @Column({ type: 'varchar', length: 64, default: 'classic' }) applied_theme: string;
+  @CreateDateColumn() created_at: Date;
+  @UpdateDateColumn() updated_at: Date;
+}
+
+@Entity('passport_pairings')
+export class PassportPairing {
+  @PrimaryColumn({ type: 'char', length: 32 }) id: string;
+  @Index() @Column({ type: 'char', length: 32 }) device_id: string;
+  @Index({ unique: true }) @Column({ type: 'char', length: 64 }) claim_hash: string;
+  @Column({ type: 'datetime' }) expires_at: Date;
+  @Column({ type: 'int', nullable: true }) claimant_id: number | null;
+  @Column({ type: 'varchar', length: 16, default: 'pending' }) status: 'pending' | 'claimed' | 'confirmed';
+  @CreateDateColumn() created_at: Date;
+}
